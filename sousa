local S={wheel=false,rl=false,fake=false,turbo=false,busy=false,fakeT=0,ret=0,side=1,over=0}
local O={
 progressive=true,wheelTurbo=false,rlTurbo=false,reverseTurbo=false,straightTurbo=false,
 twoStage=false,stage2=false,adaptive=true,infiniteNitro=false,rgbTurbo=true,
 autoDriftBoost=true,driftTurbo=false,wheelExitBoost=false
}
local C={wheel=math.rad(22),rl=math.rad(22),fake=math.rad(11),speed=105,accel=42,burst=38,rocket=88,launch=62,over=145,nitro=100,maxNitro=100,drain=20,regen=12,power=1}
local av,att,curSeat
local float={}

local function seat()
 local c=P.Character
 local h=c and c:FindFirstChildOfClass("Humanoid")
 local s=h and h.SeatPart
 return s and s:IsA("BasePart") and s or nil
end

local function root()
 local s=seat()
 return s and (s.AssemblyRootPart or s) or nil,s
end

local function clearAV()
 if av then pcall(function()av:Destroy()end)end
 if att then pcall(function()att:Destroy()end)end
 av,att,curSeat=nil,nil,nil
end

local function getAV()
 local s=seat()
 if not s then clearAV()return end
 if s==curSeat and av and av.Parent then return av,s end
 clearAV()
 curSeat=s
 att=Instance.new("Attachment",s)
 av=Instance.new("AngularVelocity",s)
 av.Attachment0=att
 av.RelativeTo=Enum.ActuatorRelativeTo.Attachment0
 av.MaxTorque=math.huge
 return av,s
end

local function dirFor(s)
 local d=s.CFrame.LookVector
 d=Vector3.new(d.X,0,d.Z)
 if d.Magnitude<.01 then return end
 d=d.Unit
 local th=0
 pcall(function()th=s.ThrottleFloat end)
 if O.reverseTurbo and th<-.05 then d=-d end
 return d
end

local function boost(dt,mul)
 local r,s=root()
 if not r or not s then return end
 local steer=0
 pcall(function()steer=s.SteerFloat end)
 if O.straightTurbo and math.abs(steer)>.12 then return end
 if not O.infiniteNitro then
  if C.nitro<=0 then return end
  C.nitro=math.max(0,C.nitro-C.drain*dt)
 end
 local d=dirFor(s)
 if not d then return end
 local v=r.AssemblyLinearVelocity
 local h=Vector3.new(v.X,0,v.Z)
 local cur=h.Magnitude
 local stage=O.twoStage and (O.stage2 and 1.28 or .78) or 1
 local target=C.speed*C.power*stage*(mul or 1)
 if os.clock()<S.over then target=math.max(target,C.over)end
 if O.adaptive then
  local k=math.clamp(1-cur/math.max(target,1),.18,1)
  target=cur+(target-cur)*k
 end
 if O.progressive then
  local t=d*math.max(target,cur)
  local dif=t-h
  local step=C.accel*C.power*stage*dt
  if dif.Magnitude>step then dif=dif.Unit*step end
  h=h+dif
 else
  h=d*math.max(target,cur)
 end
 r.AssemblyLinearVelocity=Vector3.new(h.X,v.Y,h.Z)
end

local function impulse(n)
 local r,s=root()
 if not r or not s then return end
 local d=dirFor(s)
 if not d then return end
 r.AssemblyLinearVelocity=r.AssemblyLinearVelocity+d*n*C.power
end

local function drift()
 if S.busy then return end
 local r,s=root()
 if not r or not s then return end
 local v=r.AssemblyLinearVelocity
 if Vector3.new(v.X,0,v.Z).Magnitude<5 then return end
 S.busy=true
 S.wheel,S.rl,S.fake=false,false,false
 clearAV()
 local steer=0
 pcall(function()steer=s.SteerFloat end)
 if math.abs(steer)>.1 then S.side=steer>0 and -1 or 1 else S.side=-S.side end
 local t=os.clock()
 while r.Parent and os.clock()-t<.43 do
  local z=r.AssemblyLinearVelocity
  r.AssemblyAngularVelocity=Vector3.new(0,S.side*7.3,0)
  local f=O.driftTurbo and .992 or .97
  r.AssemblyLinearVelocity=Vector3.new(z.X*f,z.Y,z.Z*f)
  RS.Heartbeat:Wait()
 end
 if r.Parent then r.AssemblyAngularVelocity=Vector3.zero end
 if O.autoDriftBoost then impulse(22)end
 S.busy=false
end

RS.Heartbeat:Connect(function(dt)
 if not O.infiniteNitro and not S.turbo then C.nitro=math.min(C.maxNitro,C.nitro+C.regen*dt)end
 if S.turbo then boost(dt,1)end
 if S.wheel and O.wheelTurbo then boost(dt,.72)end
 if S.rl and O.rlTurbo then boost(dt,.62)end
 if S.ret>0 then
  S.ret=math.max(0,S.ret-dt)
  local a=getAV()
  if a then a.AngularVelocity=Vector3.new(-math.rad(8),0,0)end
  if S.ret==0 then clearAV()end
  return
 end
 if S.wheel or S.rl or S.fake then
  local a=getAV()
  if not a then return end
  if S.wheel then a.AngularVelocity=Vector3.new(C.wheel,0,0)
  elseif S.rl then a.AngularVelocity=Vector3.new(-C.rl,0,0)
  else
   S.fakeT=S.fakeT+dt
   a.AngularVelocity=S.fakeT<.16 and Vector3.new(C.fake,0,0) or Vector3.zero
  end
 elseif not S.busy then clearAV()end
end)

