local function floating(txt,pos,hold,on,off)
 local f=Instance.new("Frame",gui)
 f.Size=UDim2.fromOffset(126,50)
 f.Position=pos
 f.BackgroundColor3=Color3.fromRGB(17,21,30)
 f.BorderSizePixel=0
 f.Visible=false
 corner(f,12)stroke(f)
 local b=Instance.new("TextButton",f)
 b.Size=UDim2.new(1,-30,1,0)
 b.BackgroundTransparency=1
 b.Text=txt
 b.TextColor3=Color3.fromRGB(245,248,255)
 b.Font=Enum.Font.GothamBold
 b.TextSize=12
 local d=Instance.new("TextButton",f)
 d.Size=UDim2.fromOffset(30,50)
 d.Position=UDim2.new(1,-30,0,0)
 d.BackgroundColor3=Color3.fromRGB(29,35,49)
 d.BorderSizePixel=0
 d.Text="⋮"
 d.TextSize=20
 d.TextColor3=Color3.fromRGB(170,185,215)
 corner(d,10)
 drag(f,d)
 if hold then
  b.InputBegan:Connect(function(i)
   if i.UserInputType~=Enum.UserInputType.Touch and i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
   local alive,moved,active=true,false,false
   local st=i.Position
   local c
   c=i.Changed:Connect(function()
    if (i.Position-st).Magnitude>12 and not active then moved=true end
    if i.UserInputState==Enum.UserInputState.End then
     alive=false
     if active then off()tw(b,.16,{BackgroundTransparency=1})end
     c:Disconnect()
    end
   end)
   task.delay(.055,function()
    if alive and not moved then
     active=true on()
     b.BackgroundTransparency=0
     b.BackgroundColor3=Color3.fromRGB(48,88,225)
    end
   end)
  end)
 else
  b.Activated:Connect(function()on()b.BackgroundTransparency=0 b.BackgroundColor3=Color3.fromRGB(48,88,225)task.delay(.1,function()tw(b,.16,{BackgroundTransparency=1})end)end)
 end
 table.insert(float,{frame=f,button=b,name=txt})
 return f,b
end

